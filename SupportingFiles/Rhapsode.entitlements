<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.naufalmir.rhapsode</string>
	</array>
	<!-- Mac Catalyst: allow loading signed SPM/framework code during local debug
	     when Team IDs differ (also covered by static AMSMB2; kept as safety net). -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>

